# Copy to .env and fill in. .env is git-ignored - never commit real values.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local database ...
DB_NAME=vetvision
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# ... or one connection string for a hosted one (Supabase / Render). When set, it wins over the DB_* values.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Production only (DJANGO_DEBUG=False): HTTPS redirect is on by default; turn the Django admin site on only if needed.
# DJANGO_SSL_REDIRECT=True
# DJANGO_ENABLE_ADMIN=False

# Google reCAPTCHA v2 ("I'm not a robot") on sign-in and sign-up. Required when DJANGO_DEBUG=False.
# These are Google's public TEST keys (always pass); get your own at https://www.google.com/recaptcha/admin
# (type: v2 "I'm not a robot" Checkbox, add your domain and localhost).
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Admin AI assistant: Google Gemini, FREE tier (key from https://aistudio.google.com, project without billing).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Tried in order when the first is busy or out of free quota (each model has its own quota):
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
