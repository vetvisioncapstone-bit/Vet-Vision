# Copy to .env and fill in. .env is git-ignored - never commit real values.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local database ...
DB_NAME=vetvision
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# ... or one connection string for a hosted one (Supabase / Render). When set, it wins over the DB_* values.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Production only (DJANGO_DEBUG=False): HTTPS redirect is on by default; turn the Django admin site on only if needed.
# DJANGO_SSL_REDIRECT=True
# DJANGO_ENABLE_ADMIN=False

# Cloudflare Turnstile (bot check on sign-in and sign-up). Required when DJANGO_DEBUG=False.
# These are Cloudflare's public TEST keys (always pass); use your own from the Cloudflare dashboard in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Admin AI assistant: Google Gemini, FREE tier (key from https://aistudio.google.com, project without billing).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
